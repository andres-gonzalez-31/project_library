# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a GitHub.

# Conexion a PostgreSQL local
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/biblioteca?schema=public"

# Clave para firmar los tokens de sesion.
# Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="pegar_aqui_una_cadena_aleatoria_larga"

# Puerto del backend
PORT=4000

# Origen permitido para CORS (el frontend)
CLIENT_URL="http://localhost:5173"

# development | production
NODE_ENV=development
